<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="560"
        x:Class="FileAsWallet.SponsorWindow"
        Title="赞助这个项目"
        Width="380" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC">

    <StackPanel Margin="20,18,20,18" Spacing="12">

        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="&#xEB51;" Classes="glyph" FontSize="17" Foreground="#C0392B" />
            <TextBlock Text="感谢使用 File as Wallet" FontSize="15" FontWeight="SemiBold"
                       Foreground="#1A1A1A" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="如果这个工具帮你省下了时间，可以请我喝杯咖啡。地址兼容 EVM 系链（以太坊、BNB Chain、Polygon 等）。"
                   FontSize="12" Foreground="#5A5A5A" TextWrapping="Wrap" LineHeight="18" />

        <Border Background="#FFFFFF" BorderBrush="#17000000" BorderThickness="1" CornerRadius="6"
                Padding="10" HorizontalAlignment="Center" Margin="0,2,0,0">
            <Path x:Name="QrPath" Stretch="Uniform" Width="216" Height="216" Fill="#121212" />
        </Border>

        <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBlock Text="EVM 地址" FontSize="11.5" Foreground="#868686" />
            <Border Background="#FFFFFF" BorderBrush="#17000000" BorderThickness="1" CornerRadius="4"
                    Padding="9,7">
                <SelectableTextBlock x:Name="AddressText" FontSize="11"
                                     FontFamily="{StaticResource MonoFont}"
                                     Foreground="#1A1A1A" TextWrapping="Wrap" LineHeight="17" />
            </Border>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
            <Button Classes="accent" Content="复制地址" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center" Click="OnCopyClick" />
            <Button Grid.Column="1" Classes="std" Content="关闭" MinWidth="76" Click="OnCloseClick" />
        </Grid>
    </StackPanel>
</Window>
